#!/bin/bash
for filename in ~/OAK_GENOMICS/RAW_DATA_SYMB/MANOS_922A/*1_001.fastq.gz;
	do
	fq=`basename ${filename} 1_001.fastq.gz`
	cmd="fastqc ~/OAK_GENOMICS/RAW_DATA_SYMB/MANOS_922A/${fq}1_001.fastq.gz ~/OAK_GENOMICS/RAW_DATA_SYMB/MANOS_922A/${fq}2_001.fastq.gz -t 5 -o ~/OAK_GENOMICS/QC/MANOS_922A/ --noextract"
	echo $cmd
done
